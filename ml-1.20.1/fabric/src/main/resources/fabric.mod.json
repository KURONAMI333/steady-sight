{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/KURONAMI333/steady-sight",
        "sources": "https://github.com/KURONAMI333/steady-sight",
        "issues": "https://x.com/kuronami333"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.kuronami.steadysight.client.SteadySightFabricClient"
        ]
    },
    "mixins": [
        {
            "config": "${mod_id}.mixins.json",
            "environment": "client"
        },
        {
            "config": "${mod_id}.fabric.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.15",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
